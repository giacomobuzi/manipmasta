<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:app="http://schemas.android.com/apk/res-auto">

    <PreferenceCategory
        app:iconSpaceReserved="false"
        app:title="@string/pref_cat_server">

        <EditTextPreference
            app:defaultValue="https://manipmasta.example.it"
            app:dialogMessage="@string/pref_url_dialog"
            app:iconSpaceReserved="false"
            app:key="server_url"
            app:title="@string/pref_url_title" />

        <EditTextPreference
            app:dialogMessage="@string/pref_token_dialog"
            app:iconSpaceReserved="false"
            app:key="api_token"
            app:title="@string/pref_token_title" />

        <Preference
            app:iconSpaceReserved="false"
            app:key="test_connection"
            app:persistent="false"
            app:summary="@string/pref_test_summary"
            app:title="@string/pref_test_title" />
    </PreferenceCategory>

    <PreferenceCategory
        app:iconSpaceReserved="false"
        app:title="@string/pref_cat_device">

        <SwitchPreferenceCompat
            app:defaultValue="true"
            app:iconSpaceReserved="false"
            app:key="keep_screen_on"
            app:summary="@string/pref_keep_screen_summary"
            app:title="@string/pref_keep_screen_title" />

        <SwitchPreferenceCompat
            app:defaultValue="false"
            app:iconSpaceReserved="false"
            app:key="notify_cycle"
            app:summary="@string/pref_notify_summary"
            app:title="@string/pref_notify_title" />
    </PreferenceCategory>

    <PreferenceCategory
        app:iconSpaceReserved="false"
        app:title="@string/pref_cat_info">

        <Preference
            app:iconSpaceReserved="false"
            app:key="version"
            app:persistent="false"
            app:selectable="false"
            app:title="@string/pref_version_title" />
    </PreferenceCategory>
</PreferenceScreen>
