# Copiare in .env e compilare. NON committare .env.

# Token per API e WebSocket (app Android e browser). Generarlo con:
#   openssl rand -hex 32
API_TOKEN=

# Broker MQTT (nome del servizio compose)
MQTT_HOST=mosquitto
MQTT_PORT=1883
TOPIC_PREFIX=manipmasta

# Utente MQTT del server
MQTT_USER=manipmasta-server
MQTT_PASS=

# Utente MQTT dell'Arduino (stesso valore da impostare in EEPROM: SET mqtt_pass ...)
MQTT_DEVICE_USER=manipmasta
MQTT_DEVICE_PASS=

# Utente di diagnostica (facoltativo, lasciare vuoto per non crearlo)
MQTT_TOOLS_PASS=

# Interfacce di ascolto sulla VM
#   MQTT_BIND = IP della VM sulla VLAN IoT (es. 192.168.50.10): il broker resta solo lì
#   HTTP_BIND = IP della VM sulla LAN dove gira Nginx Proxy Manager (0.0.0.0 = tutte)
MQTT_BIND=192.168.50.10
HTTP_BIND=0.0.0.0
HTTP_PORT=8080

# Database SQLite (dentro il container, volume ./data)
DB_PATH=/data/manipmasta.db

# Simulatore (profilo "sim"): fattore di accelerazione del tempo
SIM_SPEED=5

TZ=Europe/Rome
LOG_LEVEL=INFO
